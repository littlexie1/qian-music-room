# 复制为 .env；不要提交真实凭证。
DASHSCOPE_API_KEY=
# 从自己的百炼业务空间复制 OpenAI 兼容服务地址；地域要和 Key 匹配。
DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-omni-flash
# 通常留空，上传服务默认使用上述地址的同一域名。
DASHSCOPE_UPLOAD_BASE_URL=

# 网易云开发者应用凭证。Private Key 保存为标准 PEM 文件，路径使用 /。
NCM_APP_ID=
NCM_PRIVATE_KEY_PATH=./private/netease-private.pem

MUSIC_PORT=58238
